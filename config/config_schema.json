{
  "type": "object",
  "properties": {
    "platform": {
      "type": "object",
      "processor": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "processor"
      ]
    },
    "video": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "test": {
          "type": "boolean"
        }
      },
      "required": [
        "device",
        "width",
        "height",
        "test"
      ]
    },
    "server": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer"
        }
      },
      "required": [
        "port"
      ]
    },
    "motors": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "patternProperties": {
        "^(l|r)[01]$": {
          "type": "object",
          "properties": {
            "chip_id": { "type": "integer" },
            "channel_id": { "type": "integer" }
          },
          "required": ["chip_id", "channel_id"]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "platform",
    "video",
    "server",
    "motors"
  ]
}
